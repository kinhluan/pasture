#!/usr/bin/env bash
# commands-doc — write docs/commands.md from the headers of cmds/<group>/<command>,
# so the command reference can never drift from the commands themselves.
#
#   scripts/commands-doc           rewrite docs/commands.md
#   scripts/commands-doc --check   exit 1 (and show the diff) when it is stale
#
# It reads the same header `pasture help` reads:
#   # summary: one line
#   # usage:   pasture <group> <command> …
#   # safety:  read | write | external
#   # …        free text, up to the first line that is not a comment
# Only pasture's own cmds/ are documented, never ~/.config/pasture/cmds.local.
# The backticks in single quotes below are Markdown, not command substitution.
# shellcheck disable=SC2016
set -euo pipefail
export LC_ALL=C   # one sort order on every machine, so --check is stable

root=$(cd "$(dirname "$0")/.." && pwd)
out="$root/docs/commands.md"

field() { sed -n "s/^# $2: *//p" "$1" | head -1; }

# The free text of the header: the comment block after the shebang, without the
# three fields and without leading blank lines.
body() {
  sed -n '2,/^[^#]/p' "$1" | sed '$d' | sed 's/^# \{0,1\}//' \
    | grep -vE '^(summary|usage|safety):' \
    | awk 'NF { started = 1 } started'
}

commands() {
  local f
  for f in "$root"/cmds/*/*; do
    [[ -f "$f" && -x "$f" ]] && echo "$f"
  done
}

render() {
  local f rel group cmd summary last=""
  cat <<'EOF'
<!-- Generated by scripts/commands-doc from the headers in cmds/. Do not edit by hand: change the command's header, then run scripts/commands-doc. -->

# 🧰 Command reference

Every command of `pasture <group> <command>`, with its safety level. The same
text is in the terminal: `pasture help`, `pasture help <group> <command>`, and
`pasture list --json` for agents.

**Safety levels.** `read` only reads. `write` changes local state and has
`--dry-run`. `external` touches other systems: it prints its plan and exits 3
unless given `--yes`, so an agent shows the plan and asks you first.

**Exit codes**, shared by every command: 0 ok, 1 failed, 2 usage, 3 needs you,
4 timed out, 5 missing tool.

| Command | Safety | Does |
| ------- | ------ | ---- |
EOF
  while read -r f; do
    rel="${f#"$root"/cmds/}"
    group="${rel%%/*}" cmd="${rel#*/}"
    summary=$(field "$f" summary)
    printf '| [`pasture %s %s`](#pasture-%s-%s) | %s | %s |\n' \
      "$group" "$cmd" "$group" "$cmd" "$(field "$f" safety)" "${summary//|/\\|}"
  done < <(commands)

  while read -r f; do
    rel="${f#"$root"/cmds/}"
    group="${rel%%/*}" cmd="${rel#*/}"
    if [[ "$group" != "$last" ]]; then
      printf '\n## %s\n' "$group"
      last="$group"
    fi
    printf '\n### pasture %s %s\n\n' "$group" "$cmd"
    printf '%s\n\n' "$(field "$f" summary)"
    printf -- '- **Safety:** `%s`\n' "$(field "$f" safety)"
    printf -- '- **Usage:** `%s`\n' "$(field "$f" usage)"
    printf -- '- **Source:** [`cmds/%s`](../cmds/%s)\n' "$rel" "$rel"
    if [[ -n "$(body "$f")" ]]; then
      printf '\n```text\n%s\n```\n' "$(body "$f")"
    fi
  done < <(commands)
}

case "${1:-}" in
  --check)
    if ! diff -u "$out" <(render); then
      echo "docs/commands.md is out of date: run scripts/commands-doc" >&2
      exit 1
    fi
    ;;
  "")
    mkdir -p "$(dirname "$out")"
    render >"$out"
    echo "wrote ${out#"$root"/}"
    ;;
  *)
    echo "usage: scripts/commands-doc [--check]" >&2
    exit 2
    ;;
esac
