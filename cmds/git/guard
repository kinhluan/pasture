#!/usr/bin/env bash
# summary: Pre-push gate — block a push to a PUBLIC remote that carries a secret
# usage:   pasture git guard <remote-name> <remote-url>   (reads git pre-push stdin)
# safety:  read
#
# Written to be a git pre-push hook body (`pasture git protect` installs it).
# Reads the ref lines git feeds a pre-push hook on stdin, finds the commits
# being pushed, and runs gitleaks over just those commits:
#   public remote        → a secret BLOCKS the push (exit 1)
#   private / internal   → a secret only warns; the push proceeds
# Visibility comes from `pasture git visibility`. When the forge can't answer,
# a github.com / gitlab.com remote is treated as public (cautious); any other
# host (self-hosted, company GitLab) is treated as internal, so an off-VPN push
# is not blocked by a failed lookup. Override a block the human way:
#   git push --no-verify   — an agent must not do this on the user's behalf.
set -euo pipefail
. "$PASTURE_DIR/cmds/lib.sh"
need git

remote_name="${1:-}" remote_url="${2:-}"
[[ -n "$remote_url" ]] || usage "pasture git guard <remote-name> <remote-url>  (reads pre-push stdin)"

# Host, to decide what 'unknown' visibility means.
host=""
case "$remote_url" in
  *://*) rest="${remote_url#*://}"; rest="${rest#*@}"; host="${rest%%/*}" ;;
  *@*:*) rest="${remote_url#*@}";   host="${rest%%:*}" ;;
esac
host="${host%%:*}"

vis=$("$PASTURE_DIR/cmds/git/visibility" "$remote_url" 2>/dev/null || echo unknown)
case "$vis" in
  public)            public=true ;;
  private|internal)  public=false ;;
  *) # unknown: cautious only on the public SaaS hosts
     case "$host" in github.com|gitlab.com) public=true ;; *) public=false ;; esac ;;
esac

if ! command -v gitleaks >/dev/null; then
  $public && echo "pasture: pushing to $vis $host but gitleaks is not installed — cannot check for secrets (brew install gitleaks)" >&2
  exit 0   # can't scan → don't block; warn only
fi

z=0000000000000000000000000000000000000000
leaked=0
while read -r _ localsha _ remotesha; do
  [[ -z "${localsha:-}" || "$localsha" == "$z" ]] && continue   # nothing / branch deletion
  if [[ "$remotesha" == "$z" ]]; then
    logopts="$localsha --not --remotes"       # new branch: only commits not already on a remote
  else
    logopts="$remotesha..$localsha"           # existing branch: just the new commits
  fi
  rc=0
  gitleaks git --log-opts="$logopts" --redact --no-banner -l error >/dev/null 2>&1 || rc=$?
  case "$rc" in
    0) : ;;
    1) leaked=$((leaked+1)); echo "pasture: gitleaks found a secret in commits being pushed ($logopts)" >&2 ;;
    *) echo "pasture: gitleaks could not scan $logopts (rc $rc); not blocking on a tool error" >&2 ;;
  esac
done

(( leaked == 0 )) && exit 0

if $public; then
  echo "pasture: BLOCKED — remote '$remote_name' is $vis ($remote_url). A secret here would go public." >&2
  echo "        Remove and ROTATE the secret (a committed secret is compromised)." >&2
  echo "        Human override only: git push --no-verify" >&2
  exit 1
fi
echo "pasture: secret found, but '$remote_name' is not a public github/gitlab remote (visibility: $vis) — allowing. Still remove and ROTATE it." >&2
exit 0
