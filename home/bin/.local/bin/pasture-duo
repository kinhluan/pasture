#!/usr/bin/env bash
# pasture-duo — watch two agents talk: a writer that edits code and a
# read-only reviewer it consults through `herdr agent prompt`.
#
#   ┌──────────────┬──────────────┐
#   │  WRITER      │  REVIEWER    │   reviewer is started read-only and named,
#   │              │  (read-only) │   so the writer can reach it by name
#   ├──────────────┴──────────────┤
#   │  lazygit (full width)       │
#   └─────────────────────────────┘
#
# Usage (inside a herdr pane, at the repo root):
#   pasture-duo [writer] [reviewer]      default: claude codex
#
# A ready-to-edit writer prompt (with the review loop rules) is copied to the
# clipboard: paste it into the writer, replace <TASK>, send.
#
# Env: PASTURE_TOP (default 0.7), PASTURE_LEFT (default 0.5) — same meaning as
# in pasture-layout; PASTURE_DUO_ROUNDS (default 2) caps review rounds.
set -euo pipefail

writer="${1:-claude}"
reviewer="${2:-codex}"
top="${PASTURE_TOP:-0.7}"
left="${PASTURE_LEFT:-0.5}"
rounds="${PASTURE_DUO_ROUNDS:-2}"

die() { echo "pasture-duo: $*" >&2; exit 1; }

[[ "${HERDR_ENV:-}" == "1" ]] || die "run me inside a herdr pane (start herdr first)"
command -v "$writer" >/dev/null || die "writer '$writer' not installed"
command -v "$reviewer" >/dev/null || die "reviewer '$reviewer' not installed"

# Read-only mode per reviewer kind. The reviewer shares the writer's working
# tree, so it must never edit; that is what makes one tree (no worktree) safe.
case "$reviewer" in
  codex)       ro_args=(--sandbox read-only) ;;
  claude|grok) ro_args=(--permission-mode plan) ;;
  agy)         die "agy has no read-only mode (--sandbox only restricts its terminal); use codex, claude or grok as reviewer" ;;
  *)           die "unknown reviewer '$reviewer' (use codex, claude or grok)" ;;
esac

# herdr agent names are how the writer addresses the reviewer. They must be
# unique and match [a-z][a-z0-9_-]{0,31}, so: review-<repo>-<calling pane>.
# The pane suffix keeps two duos apart even in same-named checkouts.
slug() { tr '[:upper:]' '[:lower:]' | tr -c 'a-z0-9\n' '-'; }
pane=$(printf '%s' "${HERDR_PANE_ID:-x}" | slug)
repo=$(basename "$PWD" | slug)
max=$(( 32 - ${#pane} - 8 ))   # 8 = "review-" + "-"
name="review-${repo:0:max}-$pane"

new_pane() { herdr pane split "$@" --cwd "$PWD" --no-focus | jq -r '.result.pane.pane_id'; }

# Same order as pasture-layout: bottom first so lazygit spans the full width.
below=$(new_pane --current --direction down --ratio "$top")
right=$(new_pane --current --direction right --ratio "$left")

herdr pane run "$below" lazygit >/dev/null

echo "pasture-duo: starting $reviewer as '$name' (read-only)…"
if ! herdr agent start "$name" --kind "$reviewer" --pane "$right" --timeout 120000 \
     -- "${ro_args[@]}" >/dev/null; then
  die "could not start $reviewer in pane $right — check it there (login? trust prompt?)"
fi

# read -d '' instead of $(cat <<EOF): macOS /bin/bash 3.2 misparses quotes in
# a heredoc nested in command substitution.
read -r -d '' prompt <<EOF || true
<TASK>

When the change is ready, get a review from the read-only agent "$name":

  herdr agent prompt $name "Review the current uncommitted changes (git diff) for: <TASK>. Report only actionable findings: file:line, problem, why. No style nits." --wait --timeout 600000
  herdr agent read $name --source recent-unwrapped --lines 200

Rules:
- Fix findings you agree with. For ones you reject, send $name your reasoning in the next prompt.
- At most $rounds review rounds, then stop and summarize for me: what changed, what was fixed, what you disagreed with.
- If a herdr command returns agent_blocked, agent_prompt_stalled or times out, do NOT resend blindly:
  run "herdr agent get $name" and "herdr agent read $name" first; resend only if it is idle and never got the message, else ask me.
- Never answer approval dialogs of $name yourself.
EOF

if command -v pbcopy >/dev/null; then
  printf '%s\n' "$prompt" | pbcopy
  echo "pasture-duo: writer prompt copied to clipboard — paste it, replace <TASK>, send."
else
  printf '\n%s\n\n' "$prompt"
fi
sleep 2  # let the message be read before the writer's TUI takes over

# The calling pane becomes the writer.
exec "$writer"
