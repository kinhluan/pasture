#!/usr/bin/env bash
# pasture-collie — 🐕 the flock at a glance: every herdr agent, the ones that
# need you first. Pick a number to jump to that agent.
#
#   pasture-collie          board + jump (herdr popup on ⌃⌥S, i.e. ctrl+alt+s)
#   pasture-collie --list   board only, no prompt (for scripts / agents)
#   pasture-collie --jump   go straight to the agent that needs you most
#                           (first blocked, else first done; ⌃⌥A)
#   pasture-collie --sweep  quit every idle agent, after a y/N (⌃⌥X);
#                           engine: pasture agent sweep (--recall to call back)
#
# The barking half is the 🐕 sidebar tag from the pasture.collie plugin
# (plugins/herdr-collie) plus herdr's own notifications ([ui.toast]).
set -euo pipefail
# Popups and shell keys start from the herdr server's environment, which may
# lack ~/.local/bin or Homebrew; prefer the herdr that launched us.
PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:$PATH"
[[ -n "${HERDR_BIN_PATH:-}" ]] && PATH="$(dirname "$HERDR_BIN_PATH"):$PATH"
export PATH
# Character-aware ${var:0:n} needs a UTF-8 locale; popups may start without one.
case "${LC_ALL:-${LC_CTYPE:-${LANG:-}}}" in *UTF-8*|*utf8*) ;; *) export LC_ALL=en_US.UTF-8 ;; esac

agents=$(herdr agent list)

if [[ "${1:-}" == "--jump" ]]; then
  target=$(jq -r '[.result.agents[] | select(.agent_status == "blocked")][0].pane_id
                  // [.result.agents[] | select(.agent_status == "done")][0].pane_id
                  // empty' <<<"$agents")
  [[ -n "$target" ]] && herdr agent focus "$target" >/dev/null
  exit 0
fi

if [[ "${1:-}" == "--sweep" ]]; then
  # 💤 Send the sleeping sheep home — the engine is `pasture agent sweep`
  # (idle only; skips this pane, the focused one and named reviewers; writes
  # a ledger so `pasture agent sweep --recall` can call them back). --close
  # then shuts their tabs where nothing else runs (hx, servers stay). It
  # prints its plan and exits 3 without --yes; the y/N here is the human's yes.
  rc=0; pasture agent sweep --close || rc=$?
  if (( rc == 3 )); then
    read -r -p "💤 send them home? [y/N] (F = also force-stop the ones that ignore quit) " ok || exit 0
    case "$ok" in
      [yY]*) pasture agent sweep --yes --close || true ;;
      [fF]*) pasture agent sweep --yes --close --force || true ;;
    esac
  fi
  read -r -p "Enter to close " _ || true
  exit 0
fi

workspaces=$(herdr workspace list)
tabs=$(herdr tab list)

# One TSV row per agent, most urgent first:
#   pane_id  status_icon  agent_icon  agent  workspace · tab  title
# Emoji get their own fields: printf pads by bytes, so padding only plain text
# keeps the columns straight.
rows=$(jq -r --argjson ws "$workspaces" --argjson tabs "$tabs" '
  ($ws.result.workspaces | map({(.workspace_id): .label}) | add) as $names
  | ($tabs.result.tabs | map({(.tab_id): .label}) | add) as $tabnames
  | def rank: {"blocked":0,"done":1,"working":2,"idle":3}[.] // 4;
    def sicon: {"blocked":"⛔","done":"✅","working":"🏃","idle":"💤"}[.] // "❔";
    def aicon: {"claude":"🤖","codex":"🧠","grok":"⚡","agy":"🪐"}[.] // "🐑";
  .result.agents
  | sort_by((.agent_status | rank), ($names[.workspace_id] // .workspace_id))
  | .[]
  | [ .pane_id,
      (.agent_status | sicon),
      (.agent | aicon),
      .agent,
      (($names[.workspace_id] // .workspace_id) + " · " + ($tabnames[.tab_id] // .tab_id)),
      (.terminal_title_stripped // "" | gsub("[\t\n]"; " ")) ]
  | @tsv' <<<"$agents")

count() { jq -r --arg s "$1" '[.result.agents[] | select(.agent_status == $s)] | length' <<<"$agents"; }
total=$(jq -r '.result.agents | length' <<<"$agents")
echo "🐕 flock: $total sheep · ⛔ $(count blocked) waiting on you · ✅ $(count 'done') done · 🏃 $(count working) working"
echo

# Real width of the terminal we draw in. A herdr popup may start without
# TERM/COLUMNS, and then tput answers a default 80: ask the tty itself.
cols=$( { stty size </dev/tty; } 2>/dev/null | awk '{print $2}') || true
[[ "$cols" =~ ^[0-9]+$ && "$cols" -gt 0 ]] || cols=$(tput cols 2>/dev/null) || true
[[ "$cols" =~ ^[0-9]+$ && "$cols" -gt 0 ]] || cols=100

# "workspace · tab" column: as wide as the longest one, at most 40 characters.
wmax=0
while IFS=$'\t' read -r _ _ _ _ where _; do
  (( ${#where} > wmax )) && wmax=${#where}
done <<<"$rows"
(( wmax <= 40 )) || wmax=40
# Cells before the title: "%3d  " 5, status emoji 2 + 2 spaces, agent emoji 2
# + 1 space, agent 6 + 2 spaces, where column + 1 space.
tmax=$(( cols - (5 + 4 + 3 + 8 + wmax + 1) - 1 ))
(( tmax >= 10 )) || tmax=10

# Which panes still hold a LISTEN server or a hot background job (read-only
# recon via `pasture agent ps`). Skipped on --list so scripted calls stay fast,
# and when pasture/ps can't answer — then no ⚠ shows, nothing breaks.
warnset=" "
if [[ "${1:-}" != "--list" ]] && command -v pasture >/dev/null 2>&1; then
  warnset=" $(pasture agent ps --all --json 2>/dev/null | jq -r '.[]|select(.warn)|.pane' 2>/dev/null | tr '\n' ' ') "
fi
nwarn=$(awk '{print NF}' <<<"$warnset")
(( nwarn > 0 )) && echo "🐕 ⚠ $nwarn still holding a server / background job (s<number> to stop)" && echo

i=0
panes=()
while IFS=$'\t' read -r pane sicon aicon agent where title; do
  [[ -n "$pane" ]] || continue
  i=$((i + 1))
  panes+=("$pane")
  mk=""; case "$warnset" in *" $pane "*) mk=" ⚠" ;; esac
  # Cut by characters, not bytes (printf's %.Ns could split a UTF-8 char),
  # then pad by hand: printf pads by bytes too. Wide (CJK/emoji) text can
  # still misalign: characters are not terminal cells.
  (( ${#where} <= wmax )) || where="${where:0:$((wmax - 1))}…"
  (( ${#title} <= tmax )) || title="${title:0:$((tmax - 1))}…"
  pad=$(( wmax - ${#where} ))
  printf '%3d  %s  %s %-6s  %s%*s %s%s\n' "$i" "$sicon" "$aicon" "$agent" "$where" "$pad" "" "$title" "$mk"
done <<<"$rows"

[[ "${1:-}" == "--list" || $i -eq 0 ]] && exit 0

echo
read -r -p "🐕 number to jump · s<number> to stop · Enter to close: " pick || exit 0
# s<n> stops that agent. This is the human pressing the key in the popup — the
# allowed way to stop an agent; `pasture agent stop` is human-gated (--yes), and
# an agent must never invoke it on another. Default escalates graceful→forced.
if [[ "$pick" =~ ^[Ss]([0-9]+)$ ]]; then
  idx="${BASH_REMATCH[1]}"
  (( idx >= 1 && idx <= i )) || exit 0
  p="${panes[$((idx - 1))]}"
  pasture agent stop "$p" || true          # prints the plan (exits 3, no --yes)
  read -r -p "🛑 stop $p? [y/N] " ok || exit 0
  [[ "$ok" == [yY]* ]] || exit 0
  pasture agent stop "$p" --yes
  read -r -p "Enter to close " _ || true
  exit 0
fi
[[ "$pick" =~ ^[0-9]+$ ]] && (( pick >= 1 && pick <= i )) || exit 0
herdr agent focus "${panes[$((pick - 1))]}" >/dev/null
