#!/usr/bin/env bash
# pasture-layout — turn the current herdr pane into the pasture layout:
#
#   ┌──────────────┬──────────────┐
#   │  hx          │  AGENT       │
#   ├──────────────┴──────────────┤
#   │  lazygit (full width)       │
#   └─────────────────────────────┘
#
# lazygit gets the full width because its side panels and diff need columns,
# not rows; hx and the agent split the top evenly.
#
# Usage (inside a herdr pane, at the repo root): pasture-layout [agent]
# agent defaults to `claude`; try `codex`, `grok` or `agy`.
#
# Tune with env vars (herdr's --ratio is the share the ORIGINAL pane keeps):
#   PASTURE_TOP=0.65   top row height (hx + agent); lazygit gets the rest
#   PASTURE_LEFT=0.5   hx width within the top row; the agent gets the rest
set -euo pipefail

agent="${1:-claude}"
top="${PASTURE_TOP:-0.65}"
left="${PASTURE_LEFT:-0.5}"

if [[ "${HERDR_ENV:-}" != "1" ]]; then
  echo "pasture-layout: run me inside a herdr pane (start herdr first)" >&2
  exit 1
fi

new_pane() { herdr pane split "$@" --cwd "$PWD" --no-focus | jq -r '.result.pane.pane_id'; }

# Split off the bottom first so lazygit spans the whole width,
# then split the remaining top row into editor | agent.
below=$(new_pane --current --direction down --ratio "$top")
right=$(new_pane --current --direction right --ratio "$left")

herdr pane run "$right" "$agent" >/dev/null
herdr pane run "$below" "lazygit" >/dev/null

# The calling pane becomes the editor.
exec hx .
